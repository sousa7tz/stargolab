root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Demos com indentação de 4 espaços (mantida como estava)
[src/demo/{gym,barbershop}/**]
indent_size = 4

[src/demo/clinic/assets/css/**]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
